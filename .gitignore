.DS_Store
._*
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
.idea/
.cursor/
*.swp
*~
node_modules/
__pycache__/
*.pyc
.venv/
venv/
*.log

# env files (mirrors ~/.config/git/ignore — defense in depth)
.env
.env.local
.env.dev
.env.development
.env.production
.env.staging
.env.test
.env.keys
.envrc.local
.vercel/
