<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup rules for Android 11 and below (android:fullBackupContent).

  Save data lives in WebView localStorage under app_webview/ in the app
  data root, alongside files/ rather than inside it. Explicit includes
  limit backup to WebView data and preferences; GPU caches are excluded.
  Other root and external paths are outside this allowlist.
-->
<full-backup-content>
    <include domain="root" path="app_webview" />
    <include domain="sharedpref" path="." />
    <exclude domain="root" path="app_webview/Default/GPUCache" />
    <exclude domain="root" path="app_webview/GPUCache" />
</full-backup-content>
